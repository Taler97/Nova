<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.nova</groupId>
        <artifactId>nova</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>nova-mcp</artifactId>
    <packaging>jar</packaging>
    <name>nova-mcp</name>
    <description>Nova - MCP Server（交易能力 MCP 化，M0 阶段）</description>

    <properties>
        <!-- 与 Spring AI 1.1.x 锁定的版本保持一致 -->
        <mcp-sdk.version>0.18.3</mcp-sdk.version>
        <!-- mcp-core 要求 reactor-core 3.7.0；Spring Boot 3.1.12 默认管理 3.5.x -->
        <reactor.version>3.7.0</reactor.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MCP Java SDK：core 已内置 STDIO / SSE / Streamable HTTP 传输，无需 Web 框架 -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-core</artifactId>
            <version>${mcp-sdk.version}</version>
        </dependency>
        <!-- Jackson 2.x JSON 绑定（与 Spring Boot 3.1.12 的 Jackson 2 保持一致） -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-json-jackson2</artifactId>
            <version>${mcp-sdk.version}</version>
        </dependency>

        <!-- 显式提升 reactor-core，避免被 Boot 3.1.12 的 dependencyManagement 降级到 3.5.x -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
            <version>${reactor.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.nova.mcp.McpApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
